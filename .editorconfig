# Padronização de editores (EditorConfig) — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Quebras de linha longas em Markdown são de estilo; não cortar.
trim_trailing_whitespace = false

[*.{py,sql}]
indent_size = 4
