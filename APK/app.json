{
  "expo": {
    "name": "Gabaru",
    "slug": "gabaru",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "gabaru",
    "userInterfaceStyle": "light",
    "android": {
      "package": "br.com.gabaru.app",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ]
    ]
  }
}