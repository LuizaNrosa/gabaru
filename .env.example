# ATENÇÃO: use credenciais NOVAS e exclusivas do Gabaru.
# Não reutilize projeto Firebase, conta/chaves Stripe ou serviços do Linvuu.

NEXT_PUBLIC_SITE_URL=https://gabaru.com.br
NEXT_PUBLIC_SUPPORT_EMAIL=meugabaru@gmail.com

# Firebase (Console > Configurações do projeto > Seus apps > Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Contas de serviço > Gerar nova chave privada)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Mantenha as quebras de linha como \n dentro das aspas
FIREBASE_ADMIN_PRIVATE_KEY=
# Exemplo de formato: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# PostgreSQL (camada de dados: questões, gabaritos separados e tentativas)
# Sem esta variável, o site funciona como hoje (JSON em memória) e só as
# rotas /api/v1/attempts e /api/v1/progress respondem 503.
# Ver docs/BANCO-DADOS-LOCAL.md para migração e importação do acervo.
DATABASE_URL=
# Exemplo: postgres://usuario:senha@host:5432/gabaru

# Stripe (conta/modo do Gabaru)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Checkout de teste do Mercado Pago. Somente na Vercel Preview.
MERCADO_PAGO_ENABLE_TEST_CHECKOUT=0
MERCADO_PAGO_TEST_ACCESS_TOKEN=
MERCADO_PAGO_TEST_OPERATOR_UID=

# Ative somente após configurar e testar o webhook e o preço da conta Gabaru.
STRIPE_CHECKOUT_ENABLED=0
# Em múltiplas instâncias, usar firestore (falha fechada se indisponível).
API_RATE_LIMIT_BACKEND=firestore

# Portal Stripe: habilite Customer Portal no Dashboard da mesma conta.
# /api/stripe/portal usa o customer do usuário no servidor e retorno canônico.
# Métricas e FSRS-7 usam o mesmo Firestore Admin; DATABASE_URL não é necessário.
# Webhook: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.updated e customer.subscription.deleted.

# Billing brasileiro. Valores em centavos, definidos exclusivamente no servidor.
NEXT_PUBLIC_BILLING_ENABLED=false
# Kill switch privado adicional: exige 1 para iniciar novas cobranças.
BILLING_ENABLED=0
BILLING_PROVIDER=mercadopago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COLLECTOR_ID=
BILLING_PIX_30_CENTS=
BILLING_PIX_90_CENTS=
BILLING_PIX_365_CENTS=
BILLING_CARD_MONTHLY_CENTS=
BILLING_CARD_YEARLY_CENTS=
# Webhook HTTPS: /api/billing/webhook — payment, subscription_preapproval,
# subscription_authorized_payment. Pix não renova automaticamente.
# Pagar.me: implementar BillingProvider antes de habilitar; falha fechada hoje.

# Aliases opcionais do servidor: aceitam a credencial da conta para produção.
# O script de homologação externa só executa com token TEST-....
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_TEST_PAYER_EMAIL=
# URL HTTPS de preview para callbacks de sandbox, quando disponível.
MP_SANDBOX_NOTIFICATION_ORIGIN=

# Opcional: envio de e-mails só é disponibilizado quando houver integração configurada.
RESEND_API_KEY=
