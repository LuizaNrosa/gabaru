{
  "name": "gabaru",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:import-etec": "node scripts/import-etec-db.mjs",
    "validar:design": "node scripts/validar-design-unicamp.mjs",
    "acervo:prepare": "node scripts/restore-acervo-parts.mjs && node scripts/prepare-etec.mjs --paginar && node scripts/prepare-coluni.mjs && node scripts/prepare-ifsc.mjs && node scripts/prepare-ifsp.mjs && node scripts/paginar-acervos.mjs && node scripts/prepare-ifs-reader.mjs && node --use-env-proxy scripts/prepare-enem.mjs",
    "catalogo:gerar": "node scripts/gerar-catalogo.mjs && node scripts/gerar-seo-catalogo.mjs && node scripts/gerar-llms.mjs",
    "prebuild": "npm run validar:licencas && node scripts/gerar-capas.mjs && npm run catalogo:gerar && node scripts/gerar-manifesto-leitor.mjs",
    "validar:catalogo": "node --test tests/catalogo-v2.test.mjs",
    "validar:interface": "node scripts/verificar-interface.mjs",
    "validar:estudo": "node scripts/verificar-estudo.mjs",
    "validar:crawl": "python scripts/verificar-crawl.py",
    "build:release": "npm run acervo:prepare && npm run build",
    "pdf:inventario": "node scripts/inventariar-pdfs.mjs",
    "pdf:extrair": "node scripts/extrair-provas-pdf.mjs",
    "pdf:lote": "node scripts/extrair-lote-local.mjs",
    "resolucoes:lote": "node scripts/gerar-resolucoes-lote.mjs",
    "validar:fase2": "node --test tests/catalogo-v2.test.mjs tests/qualidade-fase2.test.mjs tests/sitemap-fase2.test.mjs tests/resolucoes-checkpoint.test.mjs",
    "validar:links": "node scripts/verificar-links-internos.mjs",
    "validar:fluxos-fase2": "node scripts/verificar-fase2.mjs",
    "acervo:sanear": "node scripts/sanear-acervo.mjs",
    "test:e2e": "playwright test",
    "test:security": "node --test tests/security-total.test.mjs",
    "test:firestore": "node --use-env-proxy scripts/testar-firestore.mjs",
    "typecheck:apk": "npm --prefix APK run typecheck",
    "validar:total": "node --test tests/catalogo-v2.test.mjs tests/qualidade-fase2.test.mjs tests/sitemap-fase2.test.mjs tests/resolucoes-checkpoint.test.mjs tests/security-total.test.mjs tests/saneamento.test.mjs tests/study-progress.test.mjs tests/incidence.test.mjs",
    "test": "node scripts/testar-unitarios.mjs",
    "validar:licencas": "node scripts/verificar-licencas.mjs",
    "postbuild": "node scripts/gerar-sitemaps.mjs"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.107.1",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "function-plot": "^1.26.0",
    "isomorphic-dompurify": "^4.7.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.73.0",
    "minisearch": "^7.2.0",
    "next": "^16.4.6",
    "next-sitemap": "^4.2.3",
    "nuqs": "^2.10.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "smiles-drawer": "^2.4.1",
    "stripe": "^17.0.0",
    "ts-fsrs": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.14.0",
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@napi-rs/canvas": "1.1.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/htmlhint": "^1.1.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-security": "^4.2.1",
    "htmlhint": "^1.9.2",
    "linkinator": "^8.1.0",
    "pdfjs-dist": "6.5.438",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "rimraf": {
      "glob": "14.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "author": {
    "name": "Luiza Nascimento Rosa",
    "url": "https://github.com/LuizaNrosa"
  },
  "license": "UNLICENSED",
  "description": "Site para vestibulinhos, vestibulares e concursos — provas oficiais verificadas, nota de corte e treino. gabaru.com.br",
  "homepage": "https://gabaru.com.br",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuizaNrosa/gabaru.git"
  },
  "bugs": {
    "url": "https://github.com/LuizaNrosa/gabaru/issues"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "copyright": "© 2026 Luiza Nascimento Rosa. Todos os direitos reservados."
}
