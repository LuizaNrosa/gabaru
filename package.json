{
  "name": "gabaru",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:import-etec": "node scripts/import-etec-db.mjs",
    "validar:design": "node scripts/validar-design-unicamp.mjs",
    "acervo:prepare": "node scripts/restore-acervo-parts.mjs && node scripts/prepare-etec.mjs --paginar && node scripts/prepare-coluni.mjs && node scripts/prepare-ifsc.mjs && node scripts/prepare-ifsp.mjs && node scripts/paginar-acervos.mjs && node scripts/prepare-ifs-reader.mjs && node --use-env-proxy scripts/prepare-enem.mjs",
    "catalogo:gerar": "node scripts/gerar-catalogo.mjs && node scripts/gerar-llms.mjs",
    "prebuild": "npm run catalogo:gerar",
    "validar:catalogo": "node --test tests/catalogo-v2.test.mjs",
    "validar:interface": "node scripts/verificar-interface.mjs",
    "validar:estudo": "node scripts/verificar-estudo.mjs",
    "validar:crawl": "python scripts/verificar-crawl.py",
    "build:release": "npm run acervo:prepare && npm run build"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "function-plot": "^1.26.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.73.0",
    "minisearch": "^7.2.0",
    "next": "^16.4.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sitemap": "^10.0.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.14.0",
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.14",
    "@napi-rs/canvas": "1.1.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.1",
    "htmlhint": "^1.9.2",
    "pdfjs-dist": "6.5.438",
    "playwright": "^1.65.0",
    "postcss": "^8.4.49",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "rimraf": {
      "glob": "14.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
