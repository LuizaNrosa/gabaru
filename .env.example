# ATENÇÃO: use credenciais NOVAS e exclusivas do Gabaru.
# Não reutilize projeto Firebase, conta/chaves Stripe ou serviços do Linvuu.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase (Console > Configurações do projeto > Seus apps > Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Contas de serviço > Gerar nova chave privada)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Mantenha as quebras de linha como \n dentro das aspas
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# PostgreSQL (camada de dados: questões, gabaritos separados e tentativas)
# Sem esta variável, o site funciona como hoje (JSON em memória) e só as
# rotas /api/v1/attempts e /api/v1/progress respondem 503.
# Ver docs/BANCO-DADOS-LOCAL.md para migração e importação do acervo.
DATABASE_URL=postgres://usuario:senha@host:5432/gabaru

# Stripe (conta/modo do Gabaru)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
